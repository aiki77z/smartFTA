NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

ENTITY_CLUSTER_INPUT_CSV=../../annotation-data-pipeline/wyf/ai_annotation_sun2000_v2_complete_offsets_fixed(1).csv
ENTITY_CLUSTER_FILE_ID=file_sun2000_8ktl_28ktl_user_manual
ENTITY_CLUSTER_OUTPUT_DIR=output/sun2000

# none: no embedding; hash: lightweight local test; sentence-transformers: local embedding model;
# openai-compatible: DashScope/OpenAI-compatible embedding API.
ENTITY_CLUSTER_EMBEDDING_BACKEND=openai-compatible
ENTITY_CLUSTER_EMBEDDING_API_KEY=your-dashscope-api-key-here
ENTITY_CLUSTER_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ENTITY_CLUSTER_EMBEDDING_MODEL=text-embedding-v4
ENTITY_CLUSTER_EMBEDDING_BATCH_SIZE=10

# Shared fallback names, compatible with FTA-GNR config.py.
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
