# MongoDB connection for reading chunks.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=smart-fta-annotation

# OpenAI-compatible LLM endpoint.
# For DashScope compatible mode, keep the default base URL and set your API key.
OPENAI_API_KEY= key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen3.6-plus

# Optional defaults used by generate_ai_annotation_dataset.py.
# You can also override these with command-line arguments.
ANNOTATION_CHUNKS_COLLECTION=chunks
